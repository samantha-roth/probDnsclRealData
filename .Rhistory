library(lhs)
Testmodel<-function (X) {
a = rep(NA,d)
for (i in 1:d){
a[i] <- i
}
up <- abs(4*X-2) + a
down <- 1 + a
prod <- prod(up/down)
return(prod)
}
d=6
x<- randomLHS(d*1000,d)
y<- apply(x,1,Testmodel)
(max(y)-min(y))/20
