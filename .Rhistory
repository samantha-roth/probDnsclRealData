# Choose the test model, the number can only be 1 (G function), 2 (Hymod) or 3 (Sacsma)
Testmodel_ind <- 1
if (Testmodel_ind == 1){ # G function
Testmodel<-function (X) {
a = rep(NA,d)
for (i in 1:d){
a[i] <- i
}
up <- abs(4*X-2) + a
down <- 1 + a
prod <- prod(up/down)
return(prod)
}
}
if(Testmodel_ind == 4){ #Morris et al 2006 function
Testmodel<- function(X){
k1<- round(d/3)
alpha <- sqrt(12) - 6*sqrt(0.1)*sqrt(k1-1)
beta <- 12 * sqrt(0.1) / sqrt(k1-1)
sum1 <- 0
for (ii in 1:k1)
{
sum1 <- sum1 + X[ii]
}
term1 <- alpha * sum1
sum2 <- 0
for (ii in 1:(k1-1))
{
for (jj in (ii+1):k1)
{
sum2 <- sum2 + X[ii]*X[jj]
}
}
term2 <- beta * sum2
y <- term1 + term2
return(y)
}
}
