c <-24 #number of workers to use for completing jobs in parallel
n_add<- c #Number of model runs to add at a time to the emulator's training data
d=6 #number of computer model parameters
par_names<- 1:d #names of computer model parameters
candidate_size<- d*1e4 #number of candidate points to consider when adding data
n_consider<- round(candidate_size/100) #top 1% of highly uncertain points to consider adding to the training data depending on their distance
seed<- 34
print(paste0("max uncertainty ",d,"D"))
# Begin with 10*d random samples from these training samples
n_init <- 10+d #initial training data size
BASS_size_vec<- n_init #vector to track current and past training data sizes
BASS_size<- n_init #current size of training data
n_empars<- d*10+4 #maximum number of emulator parameters (for the BASS emulator)
mcmc_init_size <- ceiling(2e5/n_empars)*n_empars+n_empars*1e3 #number of steps in the Markov chain to start with
wantESS<-100 #keep sampling until we get this effective sample size (ESS)
nthin<-n_empars #keep every nthin steps of the Markov chain
burn_size<-n_empars #throw out the first burn_size steps of the Markov chain
nwant_test<- 1e4
threshold<- .05 # total sensitivity value below which we deem a variable unimportant
folder <- paste0(folderpath,d,"D/",c,"cores/seed",seed,"/") #set folder depending on d and c and seed
folderpath <- "./Ranking_Data/MorrisFunc/U/"
folder <- paste0(folderpath,d,"D/",c,"cores/seed",seed,"/") #set folder depending on d and c and seed
if (!dir.exists(folder)) dir.create(file.path(folder), recursive = TRUE)
load(paste0(folder,"/y"))
load(paste0(folder,"/x"))
load(paste0(folder,"/mcmc_out"))
