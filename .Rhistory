# mcmc_out<- mcmc_out_list[[c]]
mod_list<- mcmc_out[[1]]
T_ypred_uncertainty<- vector()
start.time<- Sys.time()
y_pred<- matrix(NA,nrow=1,ncol=nrow(candidates))
for(i in 1:length(mod_list)){
mod_i<- mod_list[[i]]
valid_steps<- which(mod_i$model.lookup>0)
y_pred<- rbind(y_pred,predict(mod_i,candidates,mcmc.use= valid_steps))
}
y_pred<- y_pred[-1,]
ypred_stdev <- sqrt(apply(y_pred, 2, var))
ypred_mean<- apply(y_pred, 2, mean)
end.time<- Sys.time()
uncertainty_time<- difftime(end.time,start.time,units = "secs")
T_ypred_uncertainty<- c(T_ypred_uncertainty,uncertainty_time)
(max(ypred_mean)-min(ypred_mean))/20
